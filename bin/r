#!/bin/bash
# SSH на роутер: bin/r 'команда'  (без аргументов — интерактивный шелл)
DIR="$(cd "$(dirname "$0")/.." && pwd)"
set -a; source "$DIR/.env"; set +a
exec ssh -o UserKnownHostsFile="$DIR/.known_hosts" -o StrictHostKeyChecking=accept-new \
  -o ConnectTimeout=8 -o ServerAliveInterval=10 "$ROUTER_USER@$ROUTER_HOST" "$@"
